Subject: [PATCH] patched

---
 mdss_hdmi_edid.c | 50 +++++++++++++++++++++++++++++++++++++++++++++---
 1 file changed, 47 insertions(+), 3 deletions(-)

diff --git a/mdss_hdmi_edid.c b/mdss_hdmi_edid.c
index 5d27f96..1a4b158 100644
--- a/mdss_hdmi_edid.c
+++ b/mdss_hdmi_edid.c
@@ -916,6 +916,38 @@ static const u8 *hdmi_edid_find_hfvsdb(const u8 *in_buf)
 	return vsd;
 }
 
+/*
+ * hdmi_edid_is_dci_4k - check whether a timing info is DCI 4K (4096x2160)
+ *
+ * DCI 4K (4096x2160) is the digital-cinema variant of 4K.  Most consumer
+ * TVs are native 3840x2160 (UHD) panels, but their EDID (or the EDID
+ * shipped inside many USB-C to HDMI adapters) advertises 4096x2160 and
+ * often lists it as the preferred mode.  The display driver then outputs
+ * DCI 4K and the TV reports "4096x2160" although the panel is standard
+ * UHD.  These modes are dropped so that standard 3840x2160 UHD modes are
+ * used instead.
+ */
+static bool hdmi_edid_is_dci_4k(struct msm_hdmi_mode_timing_info *timing)
+{
+	return timing->active_h == 4096 && timing->active_v == 2160;
+}
+
+/*
+ * hdmi_edid_sanitize_preferred - never prefer a DCI 4K video format
+ *
+ * If the sink advertised a 4096x2160 mode as preferred/native, fall back
+ * to the standard UHD 3840x2160@60 (VIC 97) format instead.
+ */
+static u32 hdmi_edid_sanitize_preferred(u32 video_format)
+{
+	if (video_format >= HDMI_VFRMT_4096x2160p24_256_135 &&
+		video_format <= HDMI_VFRMT_4096x2160p60_256_135)
+		return HDMI_VFRMT_3840x2160p60_16_9;
+
+	return video_format;
+}
+
+
 static void hdmi_edid_set_y420_support(struct hdmi_edid_ctrl *edid_ctrl,
 				  u32 video_format)
 {
@@ -955,6 +987,12 @@ static void hdmi_edid_add_sink_y420_format(struct hdmi_edid_ctrl *edid_ctrl,
 		return;
 	}
 
+	if (hdmi_edid_is_dci_4k(&timing)) {
+		DEV_DBG("%s: dropping DCI 4K format %d [%s]\n", __func__,
+			video_format, msm_hdmi_mode_2string(video_format));
+		return;
+	}
+
 	if (!sink) {
 		DEV_ERR("%s: invalid input\n", __func__);
 		return;
@@ -1715,6 +1753,12 @@ static void hdmi_edid_add_sink_video_format(struct hdmi_edid_ctrl *edid_ctrl,
 		return;
 	}
 
+	if (hdmi_edid_is_dci_4k(&timing)) {
+		DEV_DBG("%s: dropping DCI 4K format %d [%s]\n", __func__,
+			video_format, msm_hdmi_mode_2string(video_format));
+		return;
+	}
+
 	DEV_DBG("%s: EDID: format: %d [%s], %s\n", __func__,
 		video_format, msm_hdmi_mode_2string(video_format),
 		supported ? "Supported" : "Not-Supported");
@@ -2078,7 +2122,7 @@ static void hdmi_edid_get_display_mode(struct hdmi_edid_ctrl *edid_ctrl)
 			/* Make a note of the preferred video format */
 			if (i == 0)
 				sink_data->preferred_video_format =
-					video_format;
+					hdmi_edid_sanitize_preferred(video_format);
 
 			if (i < 16) {
 				sink_data->disp_multi_3d_mode_list[i]
@@ -2118,7 +2162,7 @@ static void hdmi_edid_get_display_mode(struct hdmi_edid_ctrl *edid_ctrl)
 			/* Make a note of the preferred video format */
 			if (i == 0)
 				sink_data->preferred_video_format =
-					video_format;
+					hdmi_edid_sanitize_preferred(video_format);
 		}
 		desc_offset += 0x12;
 		++i;
@@ -2152,7 +2196,7 @@ static void hdmi_edid_get_display_mode(struct hdmi_edid_ctrl *edid_ctrl)
 				/* Make a note of the preferred video format */
 				if (i == 0) {
 					sink_data->preferred_video_format =
-						video_format;
+						hdmi_edid_sanitize_preferred(video_format);
 				}
 			}
 			desc_offset += 0x12;
